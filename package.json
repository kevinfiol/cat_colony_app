{
  "name": "cat-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm migrate && node --env-file=.env src/server.js",
    "dev": "pnpm migrate && node --env-file=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/migrate.js",
    "seed": "pnpm migrate && node --env-file=.env scripts/seed.js",
    "test": "node --test",
    "format": "oxfmt src scripts"
  },
  "dependencies": {
    "@openai/agents": "^0.21.0",
    "h3": "^2.0.8",
    "tempura": "^1.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxfmt": "^0.77.0"
  }
}
