{{#expect colonies}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin · Colonies</title>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <style>
    #map { height: 24rem; border-radius: 0.5rem; }
    #add form { display: grid; gap: 0.5rem; margin: 0.5rem 0 1rem; }
    #hint.missing { color: #b91c1c; font-weight: bold; }
  </style>
</head>
<body>
  <nav><a href="/admin">Today</a><a href="/admin/colonies" aria-current="page">Colonies</a><a href="/admin/cats">Cats</a></nav>
  <h1>Colonies</h1>

  <div id="map"></div>

  <details id="add">
    <summary>Add a colony</summary>
    <form method="post">
      <small id="hint" role="status">Click the map to place the new colony, or type an address and find it below.</small>
      <input name="name" aria-label="Name" placeholder="Name, e.g. Laundromat" required>
      <input name="description" aria-label="Where it is" placeholder="Where it is, e.g. behind the laundromat">
      <span class="actions">
        <input name="address" id="address" aria-label="Address" placeholder="Address, e.g. 701 NW 7th St, Miami, FL">
        <button type="button" id="find">🔎 Find on map</button>
      </span>
      <input type="hidden" name="lat">
      <input type="hidden" name="lng">
      <button>Add colony</button>
    </form>
  </details>

  {{#if colonies.length === 0}}
    <p>No colonies yet. Add the first one above.</p>
  {{/if}}
  <ul>
    {{#each colonies as colony}}
      <li class="{{ colony.urgent ? 'urgent' : '' }}" data-lat="{{ colony.lat }}" data-lng="{{ colony.lng }}" data-name="{{ colony.name }}" data-id="{{ colony.id }}">
        <a href="/admin/colonies/{{ colony.id }}"><strong>{{ colony.name }}</strong></a>
        {{#if colony.urgent}}<span class="badge">⚠️ {{ colony.urgent }} urgent</span>{{/if}}
        {{#if colony.description}}<p>{{ colony.description }}</p>{{/if}}
        {{#if colony.address}}<p>📍 {{ colony.address }}</p>{{/if}}
        <small>
          {{ colony.cats }} cats · {{ colony.fixed }} fixed · {{ colony.cats - colony.fixed }} need TNR
          {{#if colony.new_cats}} · {{ colony.new_cats }} new{{/if}}
          · last fed {{#if colony.last_fed_at}}<time datetime="{{ colony.last_fed_at }}">{{ colony.last_fed_at }} UTC</time>{{#else}}<strong>never</strong>{{/if}}
        </small>
      </li>
    {{/each}}
  </ul>

  <script src="/app.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const map = L.map('map').setView([25.7617, -80.1918], 12); // Miami
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // Each colony's marker opens its page.
    const markers = [];
    for (const li of document.querySelectorAll('li[data-lat]')) {
      const marker = L.marker([li.dataset.lat, li.dataset.lng]).addTo(map).bindTooltip(li.dataset.name);
      marker.on('click', () => (location.href = `/admin/colonies/${li.dataset.id}`));
      markers.push(marker);
    }
    if (markers.length) map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [30, 30], maxZoom: 15 });

    // Clicking the map picks the new colony's spot and opens the form.
    const add = document.getElementById('add');
    const form = add.querySelector('form');
    const hint = document.getElementById('hint');
    let pick;
    map.on('click', ({ latlng }) => {
      pick?.remove();
      pick = L.circleMarker(latlng, { color: '#d33' }).addTo(map);
      form.lat.value = latlng.lat;
      form.lng.value = latlng.lng;
      hint.textContent = 'Spot picked. Name it and add it, or click the map again to move it.';
      hint.classList.remove('missing');
      add.open = true;
      form.name.focus();
    });

    // Looks up the typed address and places the same pin the map-click above does, so there's
    // one location either way instead of the address field silently doing nothing on its own.
    const find = document.getElementById('find');
    find.addEventListener('click', async () => {
      const address = document.getElementById('address').value.trim();
      if (!address) {
        hint.textContent = 'Type an address above first.';
        return hint.classList.add('missing');
      }
      find.disabled = true;
      find.textContent = 'Finding…';
      try {
        const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(address)}`;
        const [result] = await (await fetch(url)).json();
        if (!result) {
          hint.textContent = "Couldn't find that address. Click the map to place it instead.";
          return hint.classList.add('missing');
        }
        const latlng = { lat: Number(result.lat), lng: Number(result.lon) };
        pick?.remove();
        pick = L.circleMarker(latlng, { color: '#d33' }).addTo(map);
        form.lat.value = latlng.lat;
        form.lng.value = latlng.lng;
        map.setView(latlng, 17);
        hint.textContent = 'Found it. Fine-tune by clicking the map if needed, then name it and add it.';
        hint.classList.remove('missing');
        form.name.focus();
      } catch {
        hint.textContent = "Couldn't look up that address. Click the map to place it instead.";
        hint.classList.add('missing');
      } finally {
        find.disabled = false;
        find.textContent = '🔎 Find on map';
      }
    });

    form.addEventListener('submit', (event) => {
      if (form.lat.value) return;
      event.preventDefault();
      hint.textContent = 'Click the map, or find an address, to place the colony first.';
      hint.classList.add('missing');
      document.getElementById('map').scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</body>
</html>
