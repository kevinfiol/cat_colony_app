{{#expect room, messages, isAdmin}}
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chat</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 2rem auto; padding: 0 1rem; }
    .message { background: #f1f1f1; border-radius: 0.5rem; padding: 0.5rem 0.75rem; margin: 0.5rem 0; }
    .message img { max-width: 100%; border-radius: 0.25rem; }
    .message p { margin: 0.25rem 0; }
    .message.mine { background: #dbeafe; margin-left: 3rem; }
    .message:not(.mine) { margin-right: 3rem; }
    small { color: #888; }
    form { display: grid; gap: 0.5rem; margin-top: 1rem; }
  </style>
</head>
<body>
  {{#if isAdmin}}
    <p><a href="/admin">← All chat rooms</a></p>
    <h1>{{ room.name }}</h1>
    <form method="post" action="/admin/chat/{{ room.slug }}/name">
      <input name="name" value="{{ room.name }}" required>
      <button>Rename</button>
    </form>
    <p>Volunteer link: <a href="/chat/{{ room.slug }}">/chat/{{ room.slug }}</a></p>
  {{#else}}
    <h1>{{ room.name }}</h1>
  {{/if}}

  <div id="messages">
    {{#each messages as message}}
      {{#var fromRescue = message.sender !== 'volunteer'}}
      <div class="message {{ fromRescue === isAdmin ? 'mine' : '' }}">
        <small>{{ message.sender === 'bot' ? 'Cat line' : fromRescue ? 'Rescue' : 'Volunteer' }}</small>
        {{#if message.has_photo}}
          <img src="/photos/{{ message.id }}" alt="Uploaded photo">
        {{/if}}
        {{#if message.text}}
          <p>{{ message.text }}</p>
        {{/if}}
        {{#if message.lat != null}}
          <p>📍 Location shared</p>
        {{/if}}
        <small>{{ message.created_at }} UTC</small>
      </div>
    {{/each}}
  </div>

  <form id="send" method="post" enctype="multipart/form-data">
    <textarea name="text" rows="3" placeholder="Message"></textarea>
    <input type="file" name="photo" accept="image/*">
    <input type="hidden" name="lat">
    <input type="hidden" name="lng">
    <button type="button" id="locate">📍 Add my location</button>
    <button>Send</button>
  </form>

  <script>
    const form = document.getElementById('send');

    // Send in the background instead of reloading the page.
    // The new message then shows up through the update stream below.
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      await fetch(form.action, { method: 'POST', body: new FormData(form) });
      // reset() leaves hidden inputs alone, so clear the location too.
      form.reset();
      form.lat.value = form.lng.value = '';
      locate.textContent = '📍 Add my location';
    });

    // Attaches the phone's current location to the next message.
    // Browsers only allow this over HTTPS or on localhost.
    const locate = document.getElementById('locate');
    locate.addEventListener('click', () => {
      locate.textContent = 'Finding you…';
      navigator.geolocation.getCurrentPosition(
        ({ coords }) => {
          form.lat.value = coords.latitude;
          form.lng.value = coords.longitude;
          locate.textContent = '📍 Location added';
        },
        () => (locate.textContent = '📍 Couldn’t get location, try again'),
      );
    });

    // Enter sends the message; Shift+Enter adds a new line.
    form.text.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
        event.preventDefault();
        event.target.form.requestSubmit();
      }
    });

    // Re-fetch this page and swap in the new messages on each server update.
    // Only the messages are replaced, so a half-typed reply is kept.
    new EventSource('/chat/{{ room.slug }}/events').onmessage = async () => {
      const markup = await (await fetch(location.href)).text();
      const doc = new DOMParser().parseFromString(markup, 'text/html');
      document.getElementById('messages').replaceWith(doc.getElementById('messages'));
    };
  </script>
</body>
</html>
