{{#expect rooms, approvals, newCats}}
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin · Chat rooms</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 2rem auto; padding: 0 1rem; }
    ul { list-style: none; padding: 0; }
    li { border-bottom: 1px solid #ddd; padding: 0.75rem 0; }
    .preview { color: #555; margin: 0.25rem 0; }
    small { color: #888; }
    .cat { display: flex; gap: 0.75rem; }
    .cat img { width: 5rem; height: 5rem; object-fit: cover; border-radius: 0.5rem; }
    .cat p { margin: 0.25rem 0; }
    form.inline { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
    li.unread { animation: blink 1.5s ease-in-out infinite alternate; }
    @keyframes blink { from { background: transparent; } to { background: #fde2e2; } }
    @media (prefers-reduced-motion: reduce) {
      li.unread { animation: none; background: #fde2e2; }
    }
  </style>
</head>
<body>
  <p><a href="/admin/colonies">Colonies</a></p>

  <main id="live">
  {{#if newCats.length > 0}}
    <h2>New cats</h2>
    <ul>
      {{#each newCats as cat}}
        <li class="cat">
          {{#if cat.photo_message_id}}<img src="/photos/{{ cat.photo_message_id }}" alt="">{{/if}}
          <div>
            <p>
              <strong>{{ cat.name || cat.coat }}</strong> at
              <a href="/admin/colonies/{{ cat.colony_id }}">{{ cat.colony_name }}</a>
            </p>
            <p>{{ cat.coat }} · {{ cat.markings }} · {{ cat.fixed ? 'Fixed' : 'Needs TNR' }}</p>
            {{#if cat.open_flags}}<p>⚠️ {{ cat.open_flags }}</p>{{/if}}
            <small>Reported {{ cat.sightings }} time(s) · {{ cat.created_at }} UTC</small>
            {{#if cat.maybe_same_as}}
              <p class="cat">
                Maybe the same as <strong>{{ cat.same_name || cat.same_coat }}</strong>
                {{#if cat.same_photo_message_id}}<img src="/photos/{{ cat.same_photo_message_id }}" alt="">{{/if}}
              </p>
            {{/if}}
            <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
              <button name="action" value="register">Add to colony</button>
              {{#if cat.maybe_same_as}}
                <input type="hidden" name="into" value="{{ cat.maybe_same_as }}">
                <button name="action" value="merge">Same cat</button>
              {{/if}}
              <button name="action" value="reject">Ignore</button>
            </form>
          </div>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if approvals.length > 0}}
    <h2>Waiting for you</h2>
    <ul>
      {{#each approvals as approval}}
        <li>
          <p>{{ approval.summary }}</p>
          <small>From <a href="/admin/chat/{{ approval.room_slug }}">{{ approval.room_name }}</a> · {{ approval.created_at }} UTC</small>
          <form method="post" action="/admin/approvals/{{ approval.id }}">
            <button name="approved" value="1">Approve</button>
            <button name="approved" value="0">Reject</button>
          </form>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  <h1>Chat rooms</h1>

  <form method="post" action="/admin/rooms">
    <input name="name" placeholder="Name, e.g. Maria Gomez" required>
    <button>New chat room</button>
  </form>

  <div id="rooms">
  {{#if rooms.length === 0}}
    <p>No chat rooms yet.</p>
  {{#else}}
    <ul>
      {{#each rooms as room}}
        <li class="{{ room.unread ? 'unread' : '' }}">
          <a href="/admin/chat/{{ room.slug }}">{{ room.name || room.slug }}</a>
          <p class="preview">
            {{#if room.sender === 'admin'}}You:{{/if}}
            {{#if room.text}}
              {{ room.text }}
            {{#elif room.has_photo}}
              📷 Photo
            {{#else}}
              <em>No messages yet</em>
            {{/if}}
          </p>
          <small>{{ room.last_at }} UTC</small>
        </li>
      {{/each}}
    </ul>
  {{/if}}
  </div>
  </main>

  <script>
    // Re-fetch this page and swap in the new content on each server update.
    new EventSource('/admin/events').onmessage = async () => {
      const markup = await (await fetch('/admin')).text();
      const doc = new DOMParser().parseFromString(markup, 'text/html');
      document.getElementById('live').replaceWith(doc.getElementById('live'));
    };
  </script>
</body>
</html>
