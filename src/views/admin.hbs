{{#expect rooms, approvals, newCats, flags}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin · Today</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body>
  <nav><a href="/admin" aria-current="page">Today</a><a href="/admin/colonies">Colonies</a><a href="/admin/cats">Cats</a></nav>

  <main id="live">
  <h1>Today</h1>

  {{#if flags.length === 0 && newCats.length === 0 && approvals.length === 0}}
    <p>✓ All caught up. Nothing urgent or waiting for you.</p>
  {{/if}}

  {{#if flags.length > 0}}
    <h2>Urgent ({{ flags.length }})</h2>
    <ul>
      {{#each flags as flag}}
        <li class="urgent">
          ⚠️ <strong>{{ flag.kind }}</strong> at
          <a href="/admin/colonies/{{ flag.colony_id }}">{{ flag.colony_name }}</a>
          {{#if flag.cat_id}}· <a href="/admin/cats/{{ flag.cat_id }}">{{ flag.cat_name || flag.cat_coat }}</a>{{/if}}
          <p>{{ flag.note }}</p>
          <small><time datetime="{{ flag.created_at }}">{{ flag.created_at }} UTC</time></small>
          <form class="inline" method="post" action="/admin/flags/{{ flag.id }}">
            <input type="hidden" name="back" value="/admin">
            <input name="note" aria-label="What was done?" placeholder="What was done? (optional)">
            <button>Handled</button>
          </form>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if newCats.length > 0}}
    <h2>New cats to confirm ({{ newCats.length }})</h2>
    <ul>
      {{#each newCats as cat}}
        <li class="cat">
          {{#if cat.photo_message_id}}<img src="/photos/{{ cat.photo_message_id }}" alt="{{ cat.coat }}" loading="lazy">{{/if}}
          <div>
            <p>
              <a href="/admin/cats/{{ cat.id }}"><strong>{{ cat.name || cat.coat }}</strong></a> at
              <a href="/admin/colonies/{{ cat.colony_id }}">{{ cat.colony_name }}</a>
            </p>
            <p>{{ cat.coat }} · {{ cat.markings }} · {{ cat.fixed ? 'Fixed' : 'Needs TNR' }}</p>
            {{#if cat.open_flags}}<p>⚠️ {{ cat.open_flags }}</p>{{/if}}
            <small>Reported {{ cat.sightings === 1 ? 'once' : cat.sightings + ' times' }} · <time datetime="{{ cat.created_at }}">{{ cat.created_at }} UTC</time></small>
            {{#if cat.maybe_same_as}}
              <p class="cat">
                Maybe the same as <a href="/admin/cats/{{ cat.maybe_same_as }}"><strong>{{ cat.same_name || cat.same_coat }}</strong></a>
                {{#if cat.same_photo_message_id}}<img src="/photos/{{ cat.same_photo_message_id }}" alt="{{ cat.same_coat }}" loading="lazy">{{/if}}
              </p>
            {{/if}}
            <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
              <button name="action" value="register">Add as a new cat</button>
              {{#if cat.maybe_same_as}}
                <input type="hidden" name="into" value="{{ cat.maybe_same_as }}">
                <button name="action" value="merge" data-confirm="Merge this report into {{ cat.same_name || cat.same_coat }}? This can't be undone.">Same cat, merge</button>
              {{/if}}
              <button name="action" value="reject" data-confirm="Ignore this report? It won't be counted.">Ignore</button>
            </form>
          </div>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if approvals.length > 0}}
    <h2>Waiting for your OK ({{ approvals.length }})</h2>
    <ul>
      {{#each approvals as approval}}
        <li>
          <p>{{ approval.summary }}</p>
          <small>From <a href="/admin/chat/{{ approval.room_slug }}">{{ approval.room_name }}</a> · <time datetime="{{ approval.created_at }}">{{ approval.created_at }} UTC</time></small>
          <form class="inline" method="post" action="/admin/approvals/{{ approval.id }}">
            <button name="approved" value="1">Approve</button>
            <button name="approved" value="0">Reject</button>
          </form>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  <h2>Chat rooms</h2>

  <form class="inline" method="post" action="/admin/rooms">
    <input name="name" aria-label="Volunteer's name" placeholder="Volunteer's name, e.g. Maria Gomez" required>
    <button>New chat room</button>
  </form>

  {{#if rooms.length === 0}}
    <p>No chat rooms yet. Make one for each volunteer, then send them its link.</p>
  {{#else}}
    <ul>
      {{#each rooms as room}}
        <li class="{{ room.unread ? 'new' : '' }}">
          <a href="/admin/chat/{{ room.slug }}"><strong>{{ room.name || room.slug }}</strong></a>
          {{#if room.unread}}<span class="badge">New</span>{{/if}}
          <p class="hint">
            {{#if room.sender === 'admin'}}You:{{/if}}
            {{#if room.text}}
              {{ room.text }}
            {{#elif room.has_photo}}
              📷 Photo
            {{#else}}
              <em>No messages yet</em>
            {{/if}}
          </p>
          <small><time datetime="{{ room.last_at }}">{{ room.last_at }} UTC</time></small>
        </li>
      {{/each}}
    </ul>
  {{/if}}
  </main>

  <script src="/app.js"></script>
  <script>
    // Re-fetch this page and swap in the new content on each server update.
    // If someone is typing or clicking in it, wait until they're done so nothing is lost.
    let stale = false;
    const busy = () => {
      const live = document.getElementById('live');
      return live.contains(document.activeElement) ||
        [...live.querySelectorAll('input:not([type=hidden])')].some((input) => input.value);
    };

    async function refresh() {
      stale = busy();
      if (stale) return;
      const markup = await (await fetch('/admin')).text();
      const live = new DOMParser().parseFromString(markup, 'text/html').getElementById('live');
      if (busy()) return (stale = true);
      document.getElementById('live').replaceWith(live);
      localTimes(live);
    }

    new EventSource('/admin/events').onmessage = refresh;
    document.addEventListener('focusout', () => stale && setTimeout(refresh, 300));
  </script>
</body>
</html>
