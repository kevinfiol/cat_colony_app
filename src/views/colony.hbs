{{#expect colony, cats, flags, feedings}}
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin · {{ colony.name }}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 2rem auto; padding: 0 1rem; }
    ul { list-style: none; padding: 0; }
    li { border-bottom: 1px solid #ddd; padding: 0.75rem 0; }
    small { color: #888; }
    .stats { display: flex; flex-wrap: wrap; gap: 1rem; }
    .stats div { background: #f4f4f4; border-radius: 0.5rem; padding: 0.5rem 0.75rem; }
    .stats strong { display: block; font-size: 1.5rem; }
    .cat { display: flex; gap: 0.75rem; }
    .cat img { width: 5rem; height: 5rem; object-fit: cover; border-radius: 0.5rem; }
    .cat p { margin: 0.25rem 0; }
    .new { background: #fff6d6; }
    form.inline { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  </style>
</head>
<body>
  <p><a href="/admin/colonies">← Colonies</a></p>
  <h1>{{ colony.name }}</h1>
  {{#if colony.description}}<p>{{ colony.description }}</p>{{/if}}

  <div class="stats">
    <div><strong>{{ colony.cats }}</strong>cats</div>
    <div><strong>{{ colony.fixed }}</strong>fixed</div>
    <div><strong>{{ colony.cats - colony.fixed }}</strong>need TNR</div>
    <div><strong>{{ colony.urgent }}</strong>urgent</div>
  </div>

  {{#if flags.length > 0}}
    <h2>Urgent</h2>
    <ul>
      {{#each flags as flag}}
        <li>
          ⚠️ <strong>{{ flag.kind }}</strong>
          {{#if flag.cat_coat}}· {{ flag.cat_name || flag.cat_coat }}{{/if}}
          <p>{{ flag.note }}</p>
          <small>{{ flag.created_at }} UTC</small>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  <h2>Cats</h2>
  {{#if cats.length === 0}}
    <p>No cats reported yet.</p>
  {{#else}}
    <ul>
      {{#each cats as cat}}
        <li class="cat {{ cat.status === 'pending' ? 'new' : '' }}">
          {{#if cat.photo_message_id}}<img src="/photos/{{ cat.photo_message_id }}" alt="">{{/if}}
          <div>
            <p>
              <strong>{{ cat.name || cat.coat }}</strong>
              {{#if cat.status === 'pending'}}· New, not confirmed yet{{/if}}
            </p>
            <p>{{ cat.coat }} · {{ cat.markings }} · {{ cat.fixed ? 'Fixed' : 'Needs TNR' }}</p>
            {{#if cat.open_flags}}<p>⚠️ {{ cat.open_flags }}</p>{{/if}}
            <small>Seen {{ cat.sightings }} time(s) · last {{ cat.last_seen_at }} UTC</small>
            {{#if cat.status === 'pending'}}
              <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
                <input type="hidden" name="back" value="/admin/colonies/{{ colony.id }}">
                <button name="action" value="register">Add to colony</button>
                <select name="into">
                  {{#each cats as other}}
                    {{#if other.status === 'active'}}
                      <option value="{{ other.id }}" {{ other.id === cat.maybe_same_as ? 'selected' : '' }}>
                        {{ other.name || other.coat }} (#{{ other.id }})
                      </option>
                    {{/if}}
                  {{/each}}
                </select>
                <button name="action" value="merge">Same cat as selected</button>
                <button name="action" value="reject">Ignore</button>
              </form>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  <h2>Feedings</h2>
  {{#if feedings.length === 0}}
    <p>No feedings logged.</p>
  {{#else}}
    <ul>
      {{#each feedings as feeding}}
        <li>
          <a href="/admin/chat/{{ feeding.room_id }}">{{ feeding.name || 'A volunteer' }}</a>
          <small>{{ feeding.created_at }} UTC</small>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</body>
</html>
