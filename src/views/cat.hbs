{{#expect cat, flags, history, photos, statuses, colonies, others, notifications}}
{{#var back = '/admin/cats/' + cat.id}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin · {{ cat.name || cat.coat }}</title>
  <link rel="stylesheet" href="/app.css">
  <style>
    img.photo, li img { display: block; width: 100%; max-height: 24rem; object-fit: contain; border-radius: var(--radius-sm); }
    section { border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow); padding: 0.75rem 1rem; margin: 1rem 0; }
    section h2 { margin: 0; font-size: 1rem; }
  </style>
</head>
<body>
  <div class="shell">
    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <aside class="sidebar">
      <a class="brand" href="/admin"><span class="brand-mark">🐱</span>Cat Keeper</a>
      <nav class="side-nav" aria-label="Admin">
        <a href="/admin">🏠 <span>Today</span></a>
        <a href="/admin/colonies">📍 <span>Colonies</span></a>
        <a href="/admin/cats" aria-current="page">🐾 <span>Cats</span></a>
      </nav>
    </aside>
    <label for="nav-toggle" class="nav-scrim" aria-hidden="true"></label>
    <div class="main-col">
      <header class="topbar">
        <label for="nav-toggle" class="menu-btn" aria-label="Open menu">☰</label>
        {{{ notifications }}}
      </header>
      <main class="content">
  <p><a href="/admin/colonies/{{ cat.colony_id }}">← {{ cat.colony_name }}</a></p>
  <h1>{{ cat.name || cat.coat }}</h1>
  {{#var heroPhoto = photos[0]}}
  {{#if heroPhoto}}<img class="photo" src="{{ heroPhoto.url }}" alt="{{ cat.coat }}">{{/if}}
  <p>{{ cat.coat }} · {{ cat.markings }} · {{ cat.fixed ? 'Fixed' : 'Needs TNR' }}</p>
  {{#if cat.status !== 'active'}}<p><strong>{{ cat.status === 'pending' ? 'New, not confirmed yet' : 'Marked ' + cat.status }}</strong></p>{{/if}}
  {{#if cat.fixed_at}}<p>Fixed by us <time datetime="{{ cat.fixed_at }}">{{ cat.fixed_at }} UTC</time></p>{{/if}}

  <details>
    <summary>Edit name, coat, markings or status</summary>
    <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
      <input type="hidden" name="back" value="{{ back }}">
      <label>Name <input name="name" value="{{ cat.name }}"></label>
      <label>Coat <input name="coat" value="{{ cat.coat }}" required></label>
      <label>Markings <input name="markings" value="{{ cat.markings }}"></label>
      <label>Status
        <select name="status">
          {{#each statuses as s}}<option value="{{ s }}" {{ s === cat.status ? 'selected' : '' }}>{{ s }}</option>{{/each}}
        </select>
      </label>
      <button name="action" value="edit">Save</button>
    </form>
  </details>

  {{#if flags.length > 0}}
    <section class="urgent">
      <h2>⚠️ Urgent ({{ flags.length }})</h2>
      <ul>
        {{#each flags as flag}}
          <li>
            <strong>{{ flag.kind }}</strong>
            {{#if flag.note}}<p>{{ flag.note }}</p>{{/if}}
            <small><time datetime="{{ flag.created_at }}">{{ flag.created_at }} UTC</time></small>
            <form class="inline" method="post" action="/admin/flags/{{ flag.id }}">
              <input type="hidden" name="back" value="{{ back }}">
              <input name="note" aria-label="What was done?" placeholder="What was done? (optional)">
              <button>Handled</button>
            </form>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  {{#if cat.status === 'pending'}}
    <section class="new">
      <h2>Is this a new cat?</h2>
      <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
        <input type="hidden" name="back" value="{{ back }}">
        <button name="action" value="register">Yes, add to {{ cat.colony_name }}</button>
        <button name="action" value="reject" data-confirm="Ignore this report? It won't be counted.">Ignore report</button>
      </form>
    </section>
  {{/if}}

  {{#if !cat.fixed}}
    <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
      <input type="hidden" name="back" value="{{ back }}">
      <button name="action" value="fixed" data-confirm="Mark {{ cat.name || cat.coat }} as fixed (TNR done)?">Fixed (TNR done)</button>
    </form>
  {{#else}}
    <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
      <input type="hidden" name="back" value="{{ back }}">
      <button name="action" value="unfix" data-confirm="Undo marking {{ cat.name || cat.coat }} as fixed? Use this only to correct a mistake.">Undo "Fixed"</button>
    </form>
  {{/if}}

  <details>
    <summary>Wrong colony or duplicate record?</summary>
    <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
      <input type="hidden" name="back" value="{{ back }}">
      <label>Move to
        <select name="colony_id">
          {{#each colonies as colony}}
            <option value="{{ colony.id }}" {{ colony.id === cat.colony_id ? 'selected' : '' }}>{{ colony.name }}</option>
          {{/each}}
        </select>
      </label>
      <button name="action" value="move">Move</button>
    </form>
    {{#if others.length > 0}}
      <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
        <input type="hidden" name="back" value="{{ back }}">
        <label>Same cat as
          <select name="into" required>
            <option value="">Pick a cat…</option>
            {{#each others as other}}
              <option value="{{ other.id }}" {{ other.id === cat.maybe_same_as ? 'selected' : '' }}>{{ other.name || other.coat }} · {{ other.markings }}</option>
            {{/each}}
          </select>
        </label>
        <button name="action" value="merge" data-confirm="Merge this record into the picked cat? Its history moves there and this can't be undone.">Merge</button>
      </form>
    {{#else}}
      <p class="hint">No other cats in {{ cat.colony_name }} to merge with. Move this one first if its twin is in another colony.</p>
    {{/if}}
  </details>

  <h2>Photos</h2>
  <form class="inline" method="post" action="/admin/cats/{{ cat.id }}/photos" enctype="multipart/form-data">
    <input type="file" name="photo" accept="image/*" required>
    <button>Upload photo</button>
  </form>
  {{#if photos.length > 0}}
    <div class="photo-grid">
      {{#each photos as p}}
        <a href="{{ p.url }}" target="_blank"><img src="{{ p.url }}" alt="" loading="lazy"></a>
      {{/each}}
    </div>
  {{#else}}
    <p class="hint">No photos yet.</p>
  {{/if}}

  <h2>History</h2>
  <form class="inline" method="post" action="/admin/cats/{{ cat.id }}">
    <input type="hidden" name="back" value="{{ back }}">
    <input name="note" aria-label="Note" placeholder="Add a note, e.g. vet visit, new feeder" required>
    <button name="action" value="note">Add note</button>
  </form>
  <ul>
    {{#each history as entry}}
      <li>
        {{#if entry.has_photo}}<img src="/photos/{{ entry.message_id }}" alt="Reported photo" loading="lazy">{{/if}}
        <p><strong>{{ entry.what }}</strong></p>
        {{#if entry.note}}<p>{{ entry.note }}</p>{{/if}}
        <small>
          <time datetime="{{ entry.at }}">{{ entry.at }} UTC</time>
          {{#if entry.room_slug}}
            · <a href="/admin/chat/{{ entry.room_slug }}">{{ entry.room_name || 'A volunteer' }}</a>
          {{/if}}
        </small>
      </li>
    {{/each}}
  </ul>
      </main>
    </div>
  </div>

  <script src="/app.js"></script>
</body>
</html>
